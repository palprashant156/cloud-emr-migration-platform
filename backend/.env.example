# Copy to `.env` and fill in real values. Never commit `.env`.
# Local legacy EMR PostgreSQL (read-only for this application).
PORT=3000
NODE_ENV=development

SOURCE_DB_HOST=localhost
SOURCE_DB_PORT=5432
SOURCE_DB_USERNAME=postgres
SOURCE_DB_PASSWORD=
SOURCE_DB_NAME=emr_source

# Migration target. Locally `emr_target`; in AWS this points at RDS —
# same variables, no code changes.
TARGET_DB_HOST=localhost
TARGET_DB_PORT=5432
TARGET_DB_USERNAME=postgres
TARGET_DB_PASSWORD=
TARGET_DB_NAME=emr_target
# DDL safety: false in production (schema ships as reviewed migrations).
TARGET_DB_SYNCHRONIZE=true
